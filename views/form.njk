{% include "header.njk" %}

<form class = "form-grid" id="quizForm">       
    <div class="question-block-1 frosted-paragraph">
        <h2 class = "center">When facing conflict, what is your instinct?</h2>
        <label>
            <input type="radio" name="Q1" value="0" required>
                Avoid it and wait for a better moment
        </label>
        <label>
            <input type="radio" name="Q1" value="1">
                Confront it head-on
        </label>
        <label>
            <input type="radio" name="Q1" value="2">
                Dark secrets, fear, and creepy twists
        </label>
        <label>
            <input type="radio" name="Q1" value="3">
                Outsmart the situation
        </label>
        <label>
            <input type="radio" name="Q1" value="4">
                Stay calm and analyze first
        </label>
    </div>

          <div class="question-block-2 frosted-paragraph">
            <h2 class = "center">What motivates you the most?</h2>
            <label>
              <input type="radio" name="Q2" value="0" required>
                Freedom
            </label>
            <label>
              <input type="radio" name="Q2" value="1">
                Power
            </label>
            <label>
              <input type="radio" name="Q2" value="2">
                Justice
            </label>
            <label>
              <input type="radio" name="Q2" value="3">
                Connection with others
            </label>
          </div>

          <div class="question-block-3 frosted-paragraph">
            <h2 class = "center">How do you approach failure?</h2>
            <label>
              <input type="radio" name="Q3" value="0" required>
                Reflect quietly and improve internally
            </label>
            <label>
              <input type="radio" name="Q3" value="1">
                Train harder and push limits
            </label>
            <label>
              <input type="radio" name="Q3" value="2">
                Change tactics and try a new method
            </label>
            <label>
              <input type="radio" name="Q3" value="3">
                Rely on others for support
            </label>
          </div>

          <div class="question-block-4 frosted-paragraph">
            <h2 class = "center">What role do you naturally take in a group?</h2>
            <label>
              <input type="radio" name="Q4" value="0" required>
                Leader
            </label>
            <label>
              <input type="radio" name="Q4" value="1">
                Lone wolf
            </label>
            <label>
              <input type="radio" name="Q4" value="2">
                Strategist
            </label>
            <label>
              <input type="radio" name="Q4" value="3">
                Supporter
            </label>
          </div>

          <div class="question-block-5 frosted-paragraph">
            <h2 class = "center">What is your greatest strength?</h2>
            <label>
              <input type="radio" name="Q5" value="0" required>
                Discipline
            </label>
            <label>
              <input type="radio" name="Q5" value="1">
                Intelligence
            </label>
            <label>
              <input type="radio" name="Q5" value="2">
                Charisma
            </label>
            <label>
              <input type="radio" name="Q5" value="3">
                Determination
            </label>
          </div>

          <div class="question-block-6 frosted-paragraph">
            <h2 class = "center">What scares you the most?</h2>
            <label>
              <input type="radio" name="Q6" value="0" required>
                Losing control
            </label>
            <label>
              <input type="radio" name="Q6" value="1">
                Being powerless
            </label>
            <label>
              <input type="radio" name="Q6" value="2">
                Being misunderstood
            </label>
            <label>
              <input type="radio" name="Q6" value="3">
                Being alone
            </label>
          </div>
  <button type="submit">Submit</button>
</form>

<script>
  const form = document.getElementById("quizForm");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Collect answers
    const formData = new FormData(form);
    const answers = [];

    for (let [key, value] of formData.entries()) {
      answers.push(value);
    }

    try {
      const response = await fetch("/api/submit-quiz", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ answers })
      });

      const data = await response.json();

      // Store in localStorage
      localStorage.setItem("quizResult", JSON.stringify(data));

      // Redirect to results page
      window.location.href = "/results";

    } catch (error) {
      console.error("Error submitting quiz:", error);
    }
  });
</script>